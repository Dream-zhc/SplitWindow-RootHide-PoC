<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>title</key>
    <string>SplitWindow</string>
    <key>items</key>
    <array>
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>SplitWindow</string>
            <key>footerText</key><string>iOS 16 + Dopamine RootHide。点击边缘横条打开 App 面板；长按拖动横条，松手后自动吸附到最近的左右边缘。</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>启用</string>
            <key>defaults</key><string>com.dream.splitwindow</string>
            <key>key</key><string>EnabledV040</string>
            <key>default</key><false/>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>双击外部关闭小窗</string>
            <key>defaults</key><string>com.dream.splitwindow</string>
            <key>key</key><string>DismissRequiresDoubleTap</string>
            <key>default</key><false/>
        </dict>
        <dict>
            <key>cell</key><string>PSButtonCell</string>
            <key>label</key><string>选择小窗 App</string>
            <key>action</key><string>showAppPicker</string>
        </dict>
        <dict>
            <key>cell</key><string>PSButtonCell</string>
            <key>label</key><string>启动 / 重新加载小窗</string>
            <key>action</key><string>activateSplitWindow</string>
        </dict>
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>footerText</key><string>小窗固定屏幕中心，只对完整 App 画面做等比例缩放。点击面板外只关闭面板；点击/双击小窗外关闭小窗且不会穿透到底层 App。关闭后 App 保留在系统后台。</string>
        </dict>
    </array>
</dict>
</plist>
